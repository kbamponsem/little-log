<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The running-feed and running-sleep chronometers. Denying it only hides
         the timers. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: lets the timer appear as a status-bar chip.
         A normal permission; the user can still turn promotion off. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Restore a running timer after a reboot, when the system has dropped
         every notification. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Scanning an invite code. Not required: a link can always be pasted
         instead, so a device with no camera is still a full participant. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+ package visibility. The WebView's file chooser resolves
         ACTION_IMAGE_CAPTURE before launching the camera; without this lookup
         it gets nothing and wry falls back to the file picker. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.little_log_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widget, rendered from the state file the Rust core writes. -->
        <receiver
            android:name=".widget.LittleLogWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/little_log_widget_info" />
        </receiver>
        <!-- Stop action on the running-feed notification. Not exported: only
             our own PendingIntent sends it. -->
        <receiver
            android:name=".feed.FeedStopReceiver"
            android:exported="false" />
        <!-- Wake up action on the running-sleep notification. -->
        <receiver
            android:name=".sleep.SleepStopReceiver"
            android:exported="false" />
        <!-- Stop and Switch side on the feed/sleep timer notification. -->
        <receiver
            android:name=".timer.TimerActionReceiver"
            android:exported="false" />
        <!-- Re-derive a running timer after a reboot dropped the notification. -->
        <receiver
            android:name=".timer.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Sleep and Wake Up taps from the home-screen widget. This is the
             same broadcast path as the notification actions, which is reliable
             even when the app is not open. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
