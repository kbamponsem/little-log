<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher shortcuts, the same six actions as the widget's buttons.
  They hand MainActivity an extra; the entry is written before the UI loads.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:shortcutId="log_breast_left"
        android:shortcutLongLabel="@string/shortcut_left_long"
        android:shortcutShortLabel="@string/shortcut_left_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="app.littlelog.MainActivity"
            android:targetPackage="app.littlelog">
            <extra
                android:name="app.littlelog.widget.ACTION"
                android:value="breast_left" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:shortcutId="log_breast_right"
