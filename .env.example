# Copy to .env and fill in. docker compose reads this file automatically.

# Signs session cookies and invite links. Generate your own:
#   openssl rand -hex 32
# Changing it signs every device out.
SESSION_SECRET=

# Host port. The container always listens on 8080 internally.
PORT=8080

# Set to 1 when HTTPS terminates in front of the server (Caddy, Tailscale,
# nginx…). It makes the session cookie `Secure`.
COOKIE_SECURE=0

# Log level: error | warn | info | debug | trace
RUST_LOG=info
